<script>
    // Sync mobile and desktop theme toggles
    document.addEventListener('DOMContentLoaded', function() {
        const desktopToggle = document.querySelector('#theme-toggle');
        const mobileToggle = document.querySelector('#theme-toggle-mobile');
        
        if (desktopToggle && mobileToggle) {
            // Sync initial state
            mobileToggle.checked = desktopToggle.checked;
            
            // Sync when mobile toggle changes
            mobileToggle.addEventListener('change', function() {
                desktopToggle.checked = this.checked;
                desktopToggle.dispatchEvent(new Event('change'));
            });
        }
    });
</script>