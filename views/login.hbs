<h3><i class="fas fa-dumbbell"></i> Health Tracking Web App</h3>

{{#if error}}
<div class="card-panel red lighten-4 red-text">
    <i class="fas fa-exclamation-circle"></i> {{error}}
    <button class="btn-small red right" onclick="location.reload()">Retry</button>
</div>
{{/if}}

<div class="section">
    <div class="divider"></div>
    <div class="section about-us">
        <h4>About Us</h4>
        <p class="lead">
            HealthTrackingWebApp is a platform designed to help you track and
            manage your health goals. With our app, you can create personalized
            fitness, nutrition, and health goals, monitor your progress, and
            celebrate your achievements. By logging in, you will have access to
            all of our features, which are designed to help you live a
            healthier, more balanced life.
        </p>
        <p>
            If you want to access all the features and maximize your health
            journey, please log in with your Google account.
        </p>
        <h5>TESTING</h5>
        <p>
            If you want to test the app without logging in, you can click the
            Google log in and use the following credentials:
            <b>username:</b>
            testmctest1987@gmail.com
            <b>password:</b>
            TestMcTest1987
        </p>
    </div>
    <div class="divider"></div>
</div>
<div class="divider"></div>
<div class="section">
    <a href="/auth/google" class="btn login-btn">
        <i class="fab fa-google left"></i>
        Login with Google
    </a>
</div>

<style>
    .login-btn {
        background-color: var(--primary-color, #4361ee);
        margin-top: 1rem;
        padding: 0 2rem;
    }
    
    .login-btn:hover {
        background-color: var(--primary-dark-color, #3a56d4);
    }
    
    .lead {
        font-size: 1.1rem;
        line-height: 1.6;
    }
    
    .about-us {
        margin-bottom: 2rem;
    }
    
    .card-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    .card-panel i {
        margin-right: 0.5rem;
    }
</style>

<script>
    // Clear URL parameters after displaying error
    if (window.history.replaceState) {
        const url = window.location.href.split('?')[0];
        window.history.replaceState({}, document.title, url);
    }
</script>